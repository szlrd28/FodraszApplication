@model IEnumerable<FodraszApplication.Models.Szolgaltatas>
@{
    ViewData["Title"] = "Árlista";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Árlista</h1>
    <div>
        <a class="btn btn-outline-primary me-2" asp-controller="FodraszPanel" asp-action="Foglalasaim">Fodrász panel</a>
        <a class="btn btn-primary" asp-action="Uj">Új szolgáltatás</a>
    </div>
</div>

@if (TempData["Uzenet"] is string u)
{
    <div class="alert alert-success">@u</div>
}

<form method="get" class="mb-3">
    <div class="input-group">
        <input name="q" class="form-control" placeholder="Keresés név/kód/kategória szerint" value="@Context.Request.Query["q"]" />
        <button class="btn btn-outline-secondary">Keresés</button>
    </div>
</form>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Kód</th>
            <th>Név</th>
            <th>Kategória</th>
            <th class="text-end">Perc</th>
            <th class="text-end">Ár (Ft)</th>
            <th>Aktív</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr class="@(s.Aktiv ? "" : "table-secondary")">
                <td>@s.Kod</td>
                <td>@s.Nev</td>
                <td>@s.Kategoria</td>
                <td class="text-end">@s.Perc</td>
                <td class="text-end">@s.ArHuf.ToString("N0")</td>
                <td>@(s.Aktiv ? "Igen" : "Nem")</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Szerkesztes" asp-route-id="@s.Id">Szerkesztés</a>
                    <form asp-action="Archiv" asp-route-id="@s.Id" method="post" class="d-inline">
                        <button class="btn btn-sm @(s.Aktiv ? "btn-outline-warning" : "btn-outline-success")">
                            @(s.Aktiv ? "Archiválás" : "Visszaállítás")
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
